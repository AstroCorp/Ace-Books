# Normalizar finales de línea a LF en todo el repositorio
* text=auto eol=lf

# Excepciones: scripts nativos de Windows
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# Binarios explícitos (no convertir)
*.{png,jpg,jpeg,gif,webp,ico,svg,pdf,woff,woff2,ttf,eot,zip,gz,tar,7z,rar,exe,dll,so,dylib} binary
